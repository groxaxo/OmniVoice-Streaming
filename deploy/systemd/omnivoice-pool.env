OMNIVOICE_REPO_ROOT=/home/op/OmniVoice
OMNIVOICE_PYTHON_BIN=/home/op/OmniVoice/.venv/bin/python
OMNIVOICE_ROUTER_HOST=0.0.0.0
OMNIVOICE_ROUTER_PORT=6655
# Leave GPU_UUIDS empty → auto-select the single GPU with most free VRAM (least utilization)
OMNIVOICE_GPU_UUIDS=
# Leave GPU_NAME_FILTER empty → consider all GPUs for auto-selection
OMNIVOICE_GPU_NAME_FILTER=
# Spawn 3 workers on the single auto-selected GPU
OMNIVOICE_WORKERS_PER_GPU=3
OMNIVOICE_WORKER_BASE_PORT=6656
OMNIVOICE_MIN_FREE_GPU_MB=8000
OMNIVOICE_ACQUIRE_TIMEOUT=180
OMNIVOICE_SPAWN_TIMEOUT=180
OMNIVOICE_WORKER_IDLE_TIMEOUT=300
OMNIVOICE_BACKEND_TIMEOUT=600
OMNIVOICE_STATE_DIR=/home/op/.cache/omnivoice-pool
OMNIVOICE_CELERY_BROKER_DIR=/home/op/.cache/omnivoice-pool/celery-broker
OMNIVOICE_REGISTRY_PATH=/home/op/.cache/omnivoice-pool/workers.json
OMNIVOICE_WORKER_LOG_DIR=/home/op/.cache/omnivoice-pool/logs
PYTHONPATH=/home/op/services
CUDA_DEVICE_ORDER=PCI_BUS_ID
LD_LIBRARY_PATH=/home/op/miniconda3/lib
PATH=/usr/local/bin:/usr/bin:/bin:/home/op/.local/bin:/home/op/miniconda3/bin
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
OMNIVOICE_DEFAULT_VOICE=alicia
OMNIVOICE_GRADIO_BACKEND_URL=http://127.0.0.1:6655
OMNIVOICE_GRADIO_HOST=0.0.0.0
OMNIVOICE_GRADIO_PORT=7861
OMNIVOICE_GRADIO_BACKEND_TIMEOUT=600
