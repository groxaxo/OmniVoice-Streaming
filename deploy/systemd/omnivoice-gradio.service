[Unit]
Description=OmniVoice Gradio Frontend
After=network-online.target omnivoice.service
Wants=network-online.target omnivoice.service
Requires=omnivoice.service

[Service]
Type=simple
WorkingDirectory=/home/op/OmniVoice
EnvironmentFile=/home/op/.config/omnivoice/omnivoice-pool.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/op/OmniVoice/.venv/bin/python -m omnivoice.cli.demo
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
